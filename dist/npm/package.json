  "repository": {
    "type": "git",
    "url": "git+https://github.com/pgrundev/pgboxdb.git",
    "directory": "dist/npm"
  },
  "homepage": "https://pgboxdb.com",
  "bugs": "https://github.com/pgrundev/pgboxdb/issues",
  "keywords": ["postgres", "postgresql", "database", "pgboxdb", "local", "ephemeral", "branching", "agents", "testing"],
  "bin": {
    "pgboxdb": "bin/pgboxdb.js"
  },
  "files": ["bin/", "lib/", "README.md"],
  "engines": { "node": ">=18" },
  "os": ["darwin", "linux"],
  "scripts": {
    "test": "node --test test/*.test.js"
